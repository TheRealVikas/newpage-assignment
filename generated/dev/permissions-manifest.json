{
  "environment": "dev",
  "scopes": {
    "usage:read": {
      "roles": [
        "member",
        "team_lead",
        "platform_admin"
      ],
      "group_visibility": "all"
    },
    "capabilities:write": {
      "roles": [
        "team_lead",
        "platform_admin"
      ]
    }
  },
  "capability_defaults": {
    "usage-connector": "enabled",
    "web-search": "enabled",
    "code-execution": "enabled"
  }
}
