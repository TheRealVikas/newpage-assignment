{
  "name": "meridian-usage-connector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm run ingest && npm run provision",
    "dev": "tsx apps/api/src/server.ts",
    "dev:mcp": "tsx apps/mcp/src/server.ts",
    "ingest": "tsx scripts/ingest.ts",
    "provision": "tsx scripts/provision.ts",
    "validate:provisioning": "tsx scripts/provision.ts --validate-only",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
